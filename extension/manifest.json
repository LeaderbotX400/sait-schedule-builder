{
  "manifest_version": 3,
  "name": "SAIT Schedule Builder Connector",
  "version": "1.0.0",
  "description": "Connects the SAIT Schedule Builder to your Banner session automatically.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.sait.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.sait.ca/StudentRegistrationSsb/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://localhost:*/*",
      "https://*.sait-scheduler.pages.dev/*"
    ]
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
